{
  "name": "kargah-hooshmand-app",
  "version": "1.0.0",
  "private": true,
  "description": "سامانه‌ی کارگاه هوشمند — بسته‌بندی اندروید با Capacitor",
  "scripts": {
    "sync": "npx cap sync android",
    "build:css": "tailwindcss -c tailwind.config.js -i tailwind-input.css -o style.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i tailwind-input.css -o style.css --watch"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/filesystem": "^6.0.1",
    "@capacitor/local-notifications": "^6.1.0",
    "@capacitor/share": "^6.0.2",
    "capacitor-poolakey": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "latest",
    "@capacitor/cli": "^6.1.2",
    "tailwindcss": "^3.4.19"
  }
}
